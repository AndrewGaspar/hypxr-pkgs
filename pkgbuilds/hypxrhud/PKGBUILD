# Maintainer: Andrew Gaspar

pkgname=hypxrhud
pkgver=0.20260816.1.gf96d0e794
pkgrel=1
pkgdesc='Shared OpenXR HUD daemon for HypXRland'
arch=('x86_64')
url='https://github.com/AndrewGaspar/hypxrhud'
license=('BSD-3-Clause' 'MIT' 'OFL-1.1')
depends=(
  'dbus'
  'gcc-libs'
  'glibc'
  'jansson'
  'libdrm'
  'libglvnd'
  'libxkbcommon'
  'mesa'
  'openxr'
  'systemd-libs'
)
makedepends=(
  'cmake'
  'gcc'
  'ninja'
  'pkgconf'
)
optdepends=('showmethekey: keystroke overlay backend')
options=('!debug')

_commit=f96d0e794f9cfc3505b9f671920fd091effbc7f5
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('6833e85f82e86f21cd86d33e8d2e41ab40ac205fc03aa58626619f48ec4508b5')

build() {
  cmake -S "$pkgname-$_commit" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  grep -q '^xrdeps_FOUND:INTERNAL=1$' build/CMakeCache.txt
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname-$_commit/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$pkgname-$_commit/examples/battery.toml" \
    "$pkgdir/usr/share/doc/$pkgname/battery.toml"
  install -Dm644 "$pkgname-$_commit/docs/keys-overlay.md" \
    "$pkgdir/usr/share/doc/$pkgname/docs/keys-overlay.md"
  install -Dm644 "$pkgname-$_commit/docs/cmd-ticker.md" \
    "$pkgdir/usr/share/doc/$pkgname/docs/cmd-ticker.md"
  install -Dm644 "$pkgname-$_commit/docs/battery-wivrn.md" \
    "$pkgdir/usr/share/doc/$pkgname/docs/battery-wivrn.md"
  install -Dm644 "$pkgname-$_commit/third_party/fonts/LiberationMono-OFL.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.OFL-1.1"
  install -Dm644 "$pkgname-$_commit/third_party/stb_image_write.h" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.stb_image_write"
  install -Dm644 "$pkgname-$_commit/third_party/stb_truetype.h" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.stb_truetype"
}
