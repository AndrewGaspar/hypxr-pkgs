# Maintainer: Andrew Gaspar

pkgname=hypxrcompose
pkgver=0.20260820.1.gf75ccd4ec
pkgrel=1
pkgdesc='Offline compositor for HypXRland full-fidelity XR captures'
arch=('x86_64')
url='https://github.com/AndrewGaspar/hypxrcompose'
license=('BSD-3-Clause')
depends=(
  'ffmpeg'
  'gcc-libs'
  'glibc'
  'libglvnd'
)
makedepends=(
  'cmake'
  'gcc'
  'gtest'
  'ninja'
  'nlohmann-json'
  'pkgconf'
)
options=('!debug')

_commit=f75ccd4ec60a898c50f4f7ceaedba574225ef3f4
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('205a3aeffc5a2f697713146276ea43677916adb3637c36b5383d566884f842b7')

build() {
  cmake -S "$pkgname-$_commit" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname-$_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname-$_commit/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$pkgname-$_commit/NEXT-STEPS.md" \
    "$pkgdir/usr/share/doc/$pkgname/NEXT-STEPS.md"
}
