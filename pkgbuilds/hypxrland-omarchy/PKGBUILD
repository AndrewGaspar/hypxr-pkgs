# Maintainer: Andrew Gaspar

pkgname=hypxrland-omarchy
pkgver=1.1.0
pkgrel=1
pkgdesc='Omarchy XR session installed beside the stable Omarchy session'
arch=('any')
url='https://github.com/AndrewGaspar/Hyprland'
license=('MIT')
depends=(
  'hypxrland-stack'
  'omarchy>=4.0.0'
  'omarchy<4.1'
)
makedepends=('desktop-file-utils')
source=(
  'omarchy-xr.desktop'
  'omarchy-xr-session'
  'omarchy-setup-hypxrland'
  'hyprland-xr.lua'
  'LICENSE'
)
sha256sums=(
  'cc75fe4c50416b9697f71970a691cb08ae9854d45515b8a5076b388d490d6e10'
  '6b866ffa1586ce70a0c46de0b724fa4e6b69f9b3f5024800e545b802ec043f60'
  '9740907c9bfe613e8271dc48840c77218cfa0ccdfaca062910ac3b2bbd133908'
  '65fb0fb1159451aa6634dca1852768c8c8315c27cf04681f18e3bd280154e2a9'
  '74d049fa7a0860aa2985a167b21c407e49c70eebf665813be444a7da2a16f0fe'
)

check() {
  bash -n omarchy-xr-session
  bash -n omarchy-setup-hypxrland
  desktop-file-validate omarchy-xr.desktop
  grep -Fq 'require("hyprland")' hyprland-xr.lua
  grep -Fq 'openxr = {' hyprland-xr.lua
  grep -Fq 'hl.on("hyprland.start"' hyprland-xr.lua
}

package() {
  install -Dm644 omarchy-xr.desktop \
    "$pkgdir/usr/share/wayland-sessions/omarchy-xr.desktop"
  install -Dm755 omarchy-xr-session \
    "$pkgdir/usr/bin/omarchy-xr-session"
  install -Dm755 omarchy-setup-hypxrland \
    "$pkgdir/usr/bin/omarchy-setup-hypxrland"
  install -Dm644 hyprland-xr.lua \
    "$pkgdir/usr/share/hypxrland/omarchy/hyprland-xr.lua"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
