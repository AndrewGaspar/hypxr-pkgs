prepare() {
  rm -rf "Hyprland-$_commit/subprojects/udis86"
  mv "udis86-$_udis86_commit" "Hyprland-$_commit/subprojects/udis86"
}

build() {
  export GIT_COMMIT_HASH=$_commit
  export GIT_BRANCH=hypxrland
  export GIT_COMMIT_MESSAGE="packaged HypXRland snapshot ${_commit:0:10}"
  export GIT_COMMIT_DATE=2026-08-21
  export GIT_DIRTY=clean
  export GIT_TAG="v0.56.2-374-g${_commit:0:10}"
  export GIT_COMMITS=8035

  cmake -S "Hyprland-$_commit" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_SKIP_RPATH=ON \
    -DFETCHCONTENT_SOURCE_DIR_GLAZE="$srcdir/glaze-$_glaze_commit" \
    -DNO_HYPRPM=ON \
    -DNO_TESTS=ON \
    -DBUILD_TESTING=OFF \
    -DWITH_OPENXR=ON \
    -DUSE_TRACY=OFF

  grep -q '^openxr_dep_FOUND:INTERNAL=1$' build/CMakeCache.txt
  grep -Eq '^HYPR_VULKAN_INCLUDE_DIR:PATH=/.*' build/CMakeCache.txt
  cmake --build build --target Hyprland hyprctl
}

check() {
  bash -n hypxrland-session

  local runtime_dir
  runtime_dir=$(mktemp -d)
  chmod 0700 "$runtime_dir"
  XDG_RUNTIME_DIR="$runtime_dir" build/Hyprland --version | grep -F "$_commit"
  build/hyprctl/hyprctl --help | grep -F openxr
  ! readelf -d build/Hyprland | grep -E 'RPATH|RUNPATH'
  ! ldd build/Hyprland | grep -F 'not found'
  rm -rf "$runtime_dir"
}

package() {
  install -Dm755 build/Hyprland "$pkgdir/usr/lib/hypxrland/Hyprland"
  install -Dm755 build/hyprctl/hyprctl "$pkgdir/usr/lib/hypxrland/hyprctl"
  install -Dm755 hypxrland-session "$pkgdir/usr/bin/hypxrland-session"

  install -Dm644 "Hyprland-$_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "Hyprland-$_commit/subprojects/udis86/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.udis86"
  install -Dm644 "Hyprland-$_commit/protocols/wlr-foreign-toplevel-management-unstable-v1.xml" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.HPND-sell-variant.xml"
  install -Dm644 "Hyprland-$_commit/example/openxr.conf" \
    "$pkgdir/usr/share/doc/$pkgname/openxr.conf"
  install -Dm644 "Hyprland-$_commit/docs/openxr/00-overview.md" \
    "$pkgdir/usr/share/doc/$pkgname/00-overview.md"
  install -Dm644 "Hyprland-$_commit/docs/openxr/05-configuration.md" \
    "$pkgdir/usr/share/doc/$pkgname/05-configuration.md"
  install -Dm644 "Hyprland-$_commit/contrib/mpv-hypxr-stereo.lua" \
    "$pkgdir/usr/share/hypxrland/mpv/mpv-hypxr-stereo.lua"
  install -Dm644 "Hyprland-$_commit/contrib/hyprland-xr.lua" \
    "$pkgdir/usr/share/doc/$pkgname/hyprland-xr.lua"
  install -Dm644 README.package.md \
    "$pkgdir/usr/share/doc/$pkgname/README.package.md"
}
