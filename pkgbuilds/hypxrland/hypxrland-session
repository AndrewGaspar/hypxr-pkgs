#!/bin/bash

set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
lua_config="$config_dir/hyprland-xr.lua"
legacy_config="$config_dir/hyprland-xr.conf"

if [[ -r $lua_config ]]; then
  config=$lua_config
elif [[ ! -e $lua_config && ! -L $lua_config && -r $legacy_config ]]; then
  config=$legacy_config
  echo "hypxrland-session: legacy hyprland-xr.conf is deprecated; migrate it to hyprland-xr.lua" >&2
else
  echo "hypxrland-session: XR configuration is not readable: $lua_config" >&2
  echo "Run omarchy-setup-hypxrland or create the file before starting the XR session." >&2
  exit 1
fi

export HYPXRLAND_SESSION=1
export PATH="/usr/lib/hypxrland:$PATH"

export LIBVA_DRIVER_NAME=hypxr
export LIBVA_DRIVERS_PATH="${HYPXRVA_DRIVERS_PATH:-/usr/lib/hypxrva}"

exec uwsm start -g -1 -e -N HypXRland -D Hyprland -- \
  /usr/bin/start-hyprland \
  --path /usr/lib/hypxrland/Hyprland \
  -- --config "$config"
