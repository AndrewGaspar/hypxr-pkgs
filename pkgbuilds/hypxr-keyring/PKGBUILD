package() {
  install -Dm644 hypxr.gpg "$pkgdir/usr/share/pacman/keyrings/hypxr.gpg"
  install -Dm644 hypxr-trusted "$pkgdir/usr/share/pacman/keyrings/hypxr-trusted"
  install -Dm644 hypxr-revoked "$pkgdir/usr/share/pacman/keyrings/hypxr-revoked"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
