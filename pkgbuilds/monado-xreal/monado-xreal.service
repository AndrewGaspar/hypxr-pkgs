[Unit]
Description=Monado XREAL Air OpenXR runtime for HypXRland
Documentation=https://github.com/AndrewGaspar/Hyprland
After=graphical-session.target
PartOf=graphical-session.target
# Temporary: keep the runtime off the power-saver profile while it runs (see
# hypxrland-stack's README). Mask monado-xreal-avoid-power-saver.service to opt out.
Wants=monado-xreal-avoid-power-saver.service

[Service]
Type=simple
Environment=XRT_COMPOSITOR_FORCE_WAYLAND=1
Environment=XRT_NO_STDIN=1
# The build moves the IPC socket to $XDG_RUNTIME_DIR/monado-xreal/comp_ipc and
# Monado never creates that directory. systemd creates it on start and removes
# it on stop, which also clears the socket the SIGKILL stop leaves behind.
RuntimeDirectory=monado-xreal
RuntimeDirectoryMode=0700
# Win CPU against the other apps in the session: 6DoF tracking takes more than
# a core and stutters under background load. The unit runs in app.slice, and
# user@.service delegates the cpu controller, so the weight applies there.
# There is no IOWeight=: user@.service delegates only pids, memory and cpu.
CPUWeight=1000
# Omarchy enables systemd-oomd and lets it kill in the user's app.slice. oomd
# honors this preference there because the slice and this unit's cgroup have
# the same owner. Without oomd running the line does nothing.
ManagedOOMPreference=avoid
ExecStart=/usr/lib/monado-xreal/monado-service
Restart=no
KillSignal=SIGKILL
KillMode=mixed
TimeoutStopSec=10
SuccessExitStatus=SIGKILL

[Install]
WantedBy=graphical-session.target
