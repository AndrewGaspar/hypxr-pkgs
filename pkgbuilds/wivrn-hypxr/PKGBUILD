source=(
  "wivrn-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
  "monado-$_monado_commit.tar.gz::https://gitlab.freedesktop.org/monado/monado/-/archive/$_monado_commit/monado-$_monado_commit.tar.gz"
  'LICENSE.Apache-2.0-LLVM-exception::https://raw.githubusercontent.com/llvm/llvm-project/llvmorg-22.1.0/LICENSE.TXT'
  'enable-assertions-in-server-tests.patch'
)
sha256sums=(
  '56ed5882c33f2f4b9fcba19e1a5afcabba23f785e169656ac5db15d717044a33'
  'a1af1810262d54987bd68c8b74516c39eadb37a5aa850911614fca824c8d8c94'
  '8d85c1057d742e597985c7d4e6320b015a9139385cff4cbae06ffc0ebe89afee'
  'c8bdd5ae673ef83bf964a683d0246664eb54f583685eab45c5f3cbaeb689f700'
