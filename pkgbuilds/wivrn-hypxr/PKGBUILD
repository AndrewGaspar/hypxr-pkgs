prepare() {
  local patch_file

  patch -d "WiVRn-$_commit" -p1 --forward < enable-assertions-in-server-tests.patch

  for patch_file in "WiVRn-$_commit"/patches/monado/*.patch; do
    patch -d "monado-$_monado_commit" -p1 --forward < "$patch_file"
  done
}

build() {
  cmake -S "WiVRn-$_commit" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFETCHCONTENT_SOURCE_DIR_MONADO="$srcdir/monado-$_monado_commit" \
    -DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=ALWAYS \
    -DGIT_DESC="v$_upstream_version" \
    -DGIT_COMMIT="$_commit" \
    -DWIVRN_BUILD_CLIENT=OFF \
    -DWIVRN_BUILD_DASHBOARD=OFF \
    -DWIVRN_BUILD_DISSECTOR=OFF \
    -DWIVRN_BUILD_SERVER=ON \
    -DWIVRN_BUILD_SERVER_LIBRARY=ON \
    -DWIVRN_BUILD_TEST=ON \
    -DWIVRN_BUILD_WIVRNCTL=ON \
    -DWIVRN_OPENXR_MANIFEST_TYPE=relative \
    -DWIVRN_USE_NVENC=ON \
    -DWIVRN_USE_PIPEWIRE=ON \
    -DWIVRN_USE_SYSTEM_BOOST=ON \
    -DWIVRN_USE_SYSTEMD=ON \
    -DWIVRN_USE_SYSTEM_OPENXR=ON \
    -DWIVRN_USE_VAAPI=ON \
    -DWIVRN_USE_VULKAN_ENCODE=ON \
    -DWIVRN_USE_X264=OFF
  cmake --build build
}

check() {
  local assertion_test
  local compile_command
  local test_binary
  local -a compile_commands
  local assertion_tests=(
    transfer-pacer
    take-bundle
  )
  local test_binaries=(
    build/common/recorder-packets
    build/common/recorder-names
    build/common/recorder-transfer
    build/common/take-wav
    build/server/transfer-pacer
    build/server/fov-watch
    build/server/take-bundle
  )

  for assertion_test in "${assertion_tests[@]}"; do
    mapfile -t compile_commands < <(
      ninja -C build -t commands "$assertion_test" | grep ' -c '
    )
    (( ${#compile_commands[@]} > 0 ))
    for compile_command in "${compile_commands[@]}"; do
      [[ $compile_command =~ -DNDEBUG.*-UNDEBUG ]]
    done
    printf '%s: verified -DNDEBUG is overridden by -UNDEBUG in %d compile command(s)\n' \
      "$assertion_test" "${#compile_commands[@]}"
  done

  for test_binary in "${test_binaries[@]}"; do
    "$test_binary"
  done

  (( ${#test_binaries[@]} == 7 ))
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  rm -f "$pkgdir/usr/lib/firewalld/services/wivrn.xml"
  rmdir "$pkgdir/usr/lib/firewalld/services" "$pkgdir/usr/lib/firewalld" 2>/dev/null || true
  test -x "$pkgdir/usr/bin/wivrn-server"
  test -x "$pkgdir/usr/bin/wivrnctl"
  grep -F 'libopenxr_wivrn.so' \
    "$pkgdir/usr/share/openxr/1/openxr_wivrn.json"

  install -Dm644 "WiVRn-$_commit/COPYING" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 "WiVRn-$_commit/LICENSE-OFL-1.1" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-OFL-1.1"
  install -Dm644 LICENSE.Apache-2.0-LLVM-exception \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.Apache-2.0-LLVM-exception"
  install -Dm644 "WiVRn-$_commit/external/renderdoc_app.h" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.renderdoc-MIT"
  install -Dm644 "monado-$_monado_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.monado-BSL-1.0"
  install -Dm644 "WiVRn-$_commit/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
