pkgver=26.6.2.20260820.1.g3729c7b31
pkgrel=1
_upstream_version=26.6.2
_wivrn_compat=26.6.2-1
# Tracks the upstream hypxr branch; the source remains pinned to its resolved tip.
_commit=3729c7b3106c66a69b88d812ebd6eba9c4fe4744
_monado_commit=1b526bb3a0ff326ecd05af4c2c541407f53c6d4b
pkgdesc='HypXRland-patched WiVRn OpenXR streaming server'
arch=('x86_64')
url='https://github.com/AndrewGaspar/WiVRn'
license=(
