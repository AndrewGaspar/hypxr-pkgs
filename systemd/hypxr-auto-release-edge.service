[Unit]
Description=Auto-release hypxr-pkgs for edge mirror
After=network-online.target hypxr-check-versions.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'source /root/.hypxr/build-credentials && /root/hypxr-pkgs/bin/auto-release edge'
Environment=HYPXR_STATE_DIR=/root/.hypxr/state
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
