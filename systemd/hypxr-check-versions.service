[Unit]
Description=Check PKGBUILD versions against published repo versions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/git pull --ff-only
ExecStart=/root/hypxr-pkgs/bin/check-versions
Environment=HYPXR_STATE_DIR=/root/.hypxr/state
WorkingDirectory=/root/hypxr-pkgs

[Install]
WantedBy=multi-user.target
