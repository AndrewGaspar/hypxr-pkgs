#!/bin/bash

set -euo pipefail

PUBLIC_KEY=""
PRIMARY_FINGERPRINT=""
REPO_BASE=""
CHANNEL="edge"
OUTPUT=""

usage() {
  echo "Usage: $0 --public-key <file> --primary-fingerprint <40-hex> --repo-base <https-url> --output <file> [--channel edge|stable]"
}

while (( $# > 0 )); do
  case $1 in
  --public-key)
    PUBLIC_KEY=${2:-}
    shift 2
    ;;
  --primary-fingerprint)
    PRIMARY_FINGERPRINT=${2:-}
    shift 2
    ;;
  --repo-base)
    REPO_BASE=${2:-}
    shift 2
    ;;
  --channel)
    CHANNEL=${2:-}
    shift 2
    ;;
  --output)
    OUTPUT=${2:-}
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "ERROR: Unknown option: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

PRIMARY_FINGERPRINT=${PRIMARY_FINGERPRINT//[[:space:]]/}
PRIMARY_FINGERPRINT=${PRIMARY_FINGERPRINT^^}
REPO_BASE=${REPO_BASE%/}

if [[ ! -f $PUBLIC_KEY ]]; then
  echo "ERROR: Public key does not exist: $PUBLIC_KEY" >&2
  exit 1
fi

if [[ ! $PRIMARY_FINGERPRINT =~ ^[0-9A-F]{40}$ ]]; then
  echo "ERROR: Primary fingerprint must be exactly 40 hexadecimal characters" >&2
  exit 1
fi

if [[ $CHANNEL != "edge" && $CHANNEL != "stable" ]]; then
  echo "ERROR: Channel must be edge or stable" >&2
  exit 1
fi

if [[ ! $REPO_BASE =~ ^https://[^/]+(/.*)?$ || $REPO_BASE == *'.invalid'* || $REPO_BASE == *'example.'* ]]; then
  echo "ERROR: Repository base must be a production HTTPS URL" >&2
  exit 1
fi

if [[ -z $OUTPUT || -e $OUTPUT ]]; then
  echo "ERROR: Output path must be set and must not already exist" >&2
  exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export GNUPGHOME="$work/gnupg"
mkdir -m 0700 "$GNUPGHOME"

if gpg --batch --list-packets "$PUBLIC_KEY" 2>/dev/null |
  grep -Eq '^:(secret key|secret sub key) packet:'; then
  echo "ERROR: Refusing a public-key input that contains secret key material" >&2
  exit 1
fi

mapfile -t public_fingerprints < <(gpg --batch --show-keys --with-colons "$PUBLIC_KEY" 2>/dev/null |
  awk -F: '
    $1 == "pub" { want = 1; next }
    want && $1 == "fpr" { print toupper($10); want = 0 }
  ')

if (( ${#public_fingerprints[@]} != 1 )) || [[ ${public_fingerprints[0]} != "$PRIMARY_FINGERPRINT" ]]; then
  echo "ERROR: Public key does not contain exactly the expected primary fingerprint" >&2
  exit 1
fi

gpg --batch --import "$PUBLIC_KEY" >/dev/null 2>&1
armored_key=$(gpg --batch --armor --export "$PRIMARY_FINGERPRINT")
output_dir=${OUTPUT%/*}
[[ $output_dir == "$OUTPUT" ]] && output_dir=.
mkdir -p "$output_dir"

cat >"$OUTPUT" <<EOF
#!/bin/bash

set -euo pipefail

EXPECTED_PRIMARY_FINGERPRINT='$PRIMARY_FINGERPRINT'
REPO_BASE='$REPO_BASE'
CHANNEL='$CHANNEL'

if (( EUID != 0 )); then
  echo 'ERROR: Run this installer as root (for example, curl ... | sudo bash)' >&2
  exit 1
fi

if grep -Eq '^\\[hypxr\\][[:space:]]*\$' /etc/pacman.conf; then
  echo 'ERROR: /etc/pacman.conf already contains a [hypxr] repository' >&2
  exit 1
fi

work=\$(mktemp -d)
trap 'rm -rf "\$work"' EXIT
export GNUPGHOME="\$work/gnupg"
mkdir -m 0700 "\$GNUPGHOME"

cat >"\$work/hypxr.gpg.asc" <<'HYPXR_PUBLIC_KEY'
$armored_key
HYPXR_PUBLIC_KEY

mapfile -t fingerprints < <(gpg --batch --show-keys --with-colons "\$work/hypxr.gpg.asc" |
  awk -F: '\$1 == "pub" { want = 1; next } want && \$1 == "fpr" { print toupper(\$10); want = 0 }')

if (( \${#fingerprints[@]} != 1 )) || [[ \${fingerprints[0]} != "\$EXPECTED_PRIMARY_FINGERPRINT" ]]; then
  echo 'ERROR: Embedded HypXR key does not match the pinned primary fingerprint' >&2
  exit 1
fi

unset GNUPGHOME
pacman-key --init
pacman-key --add "\$work/hypxr.gpg.asc"
pacman-key --lsign-key "\$EXPECTED_PRIMARY_FINGERPRINT"

cp /etc/pacman.conf "\$work/pacman.conf"
cat >>"\$work/pacman.conf" <<REPOSITORY

[hypxr]
SigLevel = PackageRequired DatabaseRequired TrustedOnly
Server = \$REPO_BASE/\$CHANNEL/\\\$arch
REPOSITORY

# Enroll only the dependency-free keyring here. A full system upgrade belongs
# to Omarchy's guarded update flow, which handles snapshots and migrations.
pacman --config "\$work/pacman.conf" -Sy --noconfirm --needed hypxr-keyring
install -m 0644 "\$work/pacman.conf" /etc/pacman.conf

echo 'HypXR repository enabled. Install the XR session with:'
echo '  omarchy update'
echo '  omarchy pkg add hypxrland-omarchy'
EOF

chmod 0755 "$OUTPUT"
echo "Created $OUTPUT"
echo "Primary fingerprint: $PRIMARY_FINGERPRINT"
echo "Repository: $REPO_BASE/$CHANNEL/\$arch"
