#!/bin/bash

set -euo pipefail

DIRECTORY=""

while (( $# > 0 )); do
  case $1 in
  --directory)
    if (( $# < 2 )) || [[ -z $2 ]]; then
      echo "Option --directory requires a value" >&2
      exit 1
    fi
    DIRECTORY=$2
    shift 2
    ;;
  *)
    echo "Unknown option: $1" >&2
    exit 1
    ;;
  esac
done

[[ -n $DIRECTORY ]] || { echo "--directory is required" >&2; exit 1; }
[[ -d $DIRECTORY ]] || { echo "Package directory not found: $DIRECTORY" >&2; exit 1; }

for value in HYPXR_PUBLIC_KEY HYPXR_PRIMARY_FINGERPRINT HYPXR_SIGNING_SUBKEY_FINGERPRINT; do
  if [[ -z ${!value:-} ]]; then
    echo "$value environment variable not set" >&2
    exit 1
  fi
done

gnupg_home=$(mktemp -d)
trap 'rm -rf "$gnupg_home"' EXIT
chmod 0700 "$gnupg_home"
export GNUPGHOME=$gnupg_home

gpg --batch --import <<<"$HYPXR_PUBLIC_KEY" >/dev/null 2>&1

mapfile -t packages < <(find "$DIRECTORY" -maxdepth 1 -type f -name '*.pkg.tar.zst' -print | sort)
(( ${#packages[@]} > 0 )) || { echo "No package archives found in $DIRECTORY" >&2; exit 1; }

for package in "${packages[@]}"; do
  signature="$package.sig"
  [[ -f $signature ]] || { echo "Missing package signature: $signature" >&2; exit 1; }

  status=$(gpg --batch --status-fd=1 --verify "$signature" "$package" 2>/dev/null) || {
    echo "Invalid package signature: ${package##*/}" >&2
    exit 1
  }

  if ! awk -v signing="$HYPXR_SIGNING_SUBKEY_FINGERPRINT" \
    -v primary="$HYPXR_PRIMARY_FINGERPRINT" '
      $1 == "[GNUPG:]" && $2 == "VALIDSIG" && $3 == signing && $12 == primary { valid = 1 }
      END { exit !valid }
    ' <<<"$status"; then
    echo "Package was not signed by the expected HypXR key: ${package##*/}" >&2
    exit 1
  fi
done

echo "Verified ${#packages[@]} package signature(s)"
